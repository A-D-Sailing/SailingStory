.task-panel-root {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 12px 16px;
    background-color: rgba(40, 60, 80, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(100, 150, 180, 0.5);
    min-width: 160px;
}

.task-title {
    font-size: 14px;
    color: rgb(180, 210, 230);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.task-description {
    font-size: 12px;
    color: rgb(220, 230, 240);
    white-space: normal;
}

/* Fade animation for task updates */
.task-panel-root.fade-out {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.task-panel-root.fade-in {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}
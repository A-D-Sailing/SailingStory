.cargo-map-root {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 20px;
}

/* Main title */
.main-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

/* Panels container */
.panels-container {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* Panel base styles */
.panel {
    margin: 10px;
    background-size: 100% 100%;
}

/* Cargo panel */
.cargo-panel {
    width: 340px;
    height: 650px;
    padding: 100px 30px 60px 30px;
    background-image: url("project://database/Assets/Images/UI/cargo.png");
    flex-direction: column;
}

.cargo-header {
    align-items: center;
    margin-bottom: 50px;
}

.cargo-title {
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(90, 60, 40);
    -unity-font-style: bold;
}

.gold-label {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(90, 60, 40);
    margin-top: 2px;
}

/* Market panel */
.market-panel {
    width: 340px;
    height: 600px;
    padding: 150px 50px 120px 50px;
    background-image: url("project://database/Assets/Images/UI/market.png");
    flex-direction: column;
}

.market-title {
    position: absolute;
    top: 6px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* Grid container overrides for CargoMap */
.cargo-grid {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    align-self: center;
    background-color: rgba(80, 50, 30, 0.7);
    border-width: 1px;
    border-color: rgb(50, 30, 15);
}

.market-grid {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    align-self: center;
    background-color: rgba(90, 55, 35, 0.5);
    border-width: 1px;
    border-color: rgb(50, 30, 15);
}

/* Buttons container */
.buttons-container {
    flex-direction: column;
    align-items: center;
    margin-top: 15px;
}

/* Action buttons */
.action-btn {
    min-width: 160px;
    height: 40px;
    margin: 5px;
    padding: 8px 20px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 2px;
    background-color: rgb(230, 180, 80);
    border-color: rgb(180, 130, 50);
    color: rgb(60, 40, 20);
}

.action-btn:hover {
    background-color: rgb(250, 200, 100);
}

.action-btn:active {
    background-color: rgb(200, 150, 60);
    scale: 0.98;
}

.settle-depart-btn {
    background-color: rgb(230, 180, 80);
}

.fix-hold-btn {
    display: none;
    background-color: rgb(205, 120, 90);
    border-color: rgb(150, 80, 60);
    color: rgb(255, 240, 230);
}

.fix-hold-btn.repair-mode {
    background-color: rgb(170, 85, 65);
}

.popup-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    align-items: center;
    display: none;
}

.popup-label {
    padding: 10px 14px;
    border-width: 1px;
    border-color: rgb(135, 70, 55);
    border-radius: 6px;
    background-color: rgb(230, 190, 160);
    color: rgb(80, 30, 20);
    -unity-font-style: bold;
    font-size: 14px;
}

/* Cell styles for cargo map */
.cargo-map-root .icon-grid-cell {
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-color: rgb(50, 30, 15);
    background-color: rgb(160, 120, 90);
    border-radius: 0;
}

.cargo-map-root .icon-grid-cell:hover {
    background-color: rgba(180, 140, 100, 0.8);
}

.cargo-map-root .icon-grid-cell:active {
    scale: 0.95;
    background-color: rgba(200, 160, 110, 0.9);
}

/* Cargo item cell styles */
.cargo-item .icon-grid-icon {
    --unity-image-size: scale-to-fit;
}

.toolkit-cell .icon-grid-icon {
    --unity-image: url("project://database/Assets/Images/UI/toolkit.svg");
}

.plank-cell .icon-grid-icon {
    --unity-image: url("project://database/Assets/Images/UI/plank.svg");
}

.shipwright-cell .icon-grid-icon {
    --unity-image: url("project://database/Assets/Images/UI/shipwright.svg");
}

.crate-cell .icon-grid-icon {
    --unity-image: url("project://database/Assets/Images/UI/crate.svg");
}

/* Damaged cell styles (higher specificity to override base icon-grid-cell styles) */
.cargo-map-root .icon-grid-cell.damaged-cell {
    background-color: rgb(153, 74, 68);
    border-color: rgb(176, 86, 78);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    scale: 1;
}

.cargo-map-root .icon-grid-cell.damaged-cell:hover {
    background-color: rgb(153, 74, 68);
}

.cargo-map-root .icon-grid-cell.damaged-cell:active {
    background-color: rgb(153, 74, 68);
    scale: 1;
}
